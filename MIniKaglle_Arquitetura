const express = require("express");
const axios = require("axios");
const cors = require("cors");

const app = express();
app.use(cors());
app.use(express.static("public"));

const PORT = 3000;

// 🔐 Coloque suas credenciais do Kaggle aqui
const USERNAME = "SEU_USERNAME";
const KEY = "SUA_API_KEY";

// 🔎 Rota de busca
app.get("/buscar", async (req, res) => {
    const termo = req.query.q;

    try {
        const response = await axios.get(
            "https://www.kaggle.com/api/v1/datasets/list",
            {
                params: { search: termo },
                auth: {
                    username: USERNAME,
                    password: KEY
                }
            }
        );

        res.json(response.data);

    } catch (erro) {
        res.status(500).json({ erro: "Erro ao buscar no Kaggle" });
    }
});

app.listen(PORT, () => {
    console.log("Servidor rodando em http://localhost:3000");
});


index.html

<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>Mini Kaggle Search</title>

<style>
body {
    font-family: Arial, sans-serif;
    background: #fff;
    text-align: center;
    margin-top: 150px;
}

/* "Logo" estilo Google */
.logo {
    font-size: 48px;
    color: #4285F4;
}

/* Input */
input {
    width: 450px;
    padding: 12px;
    border-radius: 25px;
    border: 1px solid #ddd;
    outline: none;
}

/* Botão */
button {
    margin-top: 10px;
    padding: 10px 20px;
    border: none;
    border-radius: 20px;
    cursor: pointer;
}

/* Resultados */
#resultados {
    margin-top: 40px;
    width: 700px;
    margin-left: auto;
    margin-right: auto;
    text-align: left;
}

.resultado {
    margin-bottom: 20px;
