</head>

<body>

<h1 class="logo">MiniKaggle 🔎</h1>

<input type="text" id="busca" placeholder="Buscar datasets...">
<br>
<button onclick="buscar()">Buscar</button>

<div id="resultados"></div>

<script>
// Permitir Enter para buscar
document.getElementById("busca").addEventListener("keypress", function(e) {
    if (e.key === "Enter") {
        buscar();
    }
});

async function buscar() {
    const termo = document.getElementById("busca").value;
    const resultadosDiv = document.getElementById("resultados");

    resultadosDiv.innerHTML = "Carregando...";

    try {
        const res = await fetch(`/buscar?q=${termo}`);
        const dados = await res.json();

        resultadosDiv.innerHTML = "";

        if (dados.length === 0) {
            resultadosDiv.innerHTML = "Nenhum resultado encontrado.";
            return;
        }

        dados.forEach(item => {
            const div = document.createElement("div");
            div.classList.add("resultado");

            div.innerHTML = `
                <h3>${item.title}</h3>
                <p>${item.subtitle || ""}</p>
                <small>Autor: ${item.ownerName}</small>
            `;

            resultadosDiv.appendChild(div);
        });

    } catch (erro) {
        resultadosDiv.innerHTML = "Erro ao buscar dados.";
    }
}
</script>

</body>
</html>
